pkgname=mread
pkgver=0.1.0
pkgrel=1
pkgdesc='Minimal Markdown reader with vim keys that follows the Omarchy theme'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'fd')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/mread "$pkgdir/usr/bin/mread"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/mread.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mread.svg"
  install -Dm644 "$startdir/mread.desktop" "$pkgdir/usr/share/applications/mread.desktop"
}
